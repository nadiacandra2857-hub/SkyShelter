# Weather-Responsive Roofing System Frontend Configuration
# http://127.0.0.1:8000/api/v1 atau http://localhost:8000/api/v1
VITE_API_BASE_URL=http://localhost:8005/api/v1

# Mode Simulasi (true: menggunakan mock service terisolasi, false: menggunakan FastAPI backend)
VITE_USE_MOCK_DATA=false

# OpenWeatherMap / Satelit Radar Configuration (Permanent Active)
VITE_OPENWEATHER_API_KEY=permanent_active
