# ===============================================================
# Weather-Responsive Roofing System V2.0 - Backend Configuration
# ===============================================================

# --- Application Settings ---
APP_NAME="Weather-Responsive Roofing System V2.0"
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

# --- Database ---
DATABASE_URL=sqlite:///./weather_roofing.db

# --- CORS Frontend Origins (Comma-separated for multiple origins) ---
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Security & JWT ---
# Ganti dengan secret key acak yang kuat di production (misal: openssl rand -hex 32)
JWT_SECRET_KEY=replace-with-a-very-strong-and-secure-random-secret-key-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Initial Admin User (Untuk inisialisasi awal database) ---
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_EMAIL=admin@jemuran.local
ADMIN_INITIAL_PASSWORD=adminPassword123!
ADMIN_INITIAL_FULL_NAME="System Administrator"

# --- Device Mode & Timeout ---
# simulation: mensimulasikan sensor & pergerakan atap secara otomatis tanpa hardware ESP8266
# real: menunggu telemetri dan konfirmasi fisik nyata dari ESP8266
DEVICE_MODE=simulation
# Batas waktu deteksi offline jika heartbeat/telemetri tidak diterima (detik)
DEVICE_OFFLINE_TIMEOUT_SECONDS=120
DEFAULT_DEVICE_ID=roof-001

# --- MQTT Broker Settings ---
MQTT_ENABLED=false
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=weather-roofing-backend
MQTT_USE_TLS=false
MQTT_KEEP_ALIVE=60

# --- Weather Provider & Early-Close Logic ---
# Pilihan provider: bmkg atau openweathermap
WEATHER_PROVIDER=bmkg
# BMKG Open Data endpoint base URL (jika kosong, menggunakan adapter publik BMKG)
BMKG_API_BASE_URL=https://api.bmkg.go.id/publik/prakiraan-cuaca
# Koordinat / Wilayah (contoh: adm4 BMKG code atau nama kota)
WEATHER_LOCATION=DKI Jakarta
# OpenWeatherMap (Fallback atau alternatif)
OPENWEATHER_API_KEY=
OPENWEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# Interval polling otomatis data cuaca oleh background worker (menit)
WEATHER_POLL_INTERVAL_MINUTES=15
# Cache duration untuk menghindari penembakan API berlebih (menit)
WEATHER_CACHE_MINUTES=10
# Cooldown manual refresh endpoint (detik)
WEATHER_REFRESH_COOLDOWN_SECONDS=60

# Ambang batas Early-Close (persentase probabilitas hujan, 0-100%)
EARLY_CLOSE_THRESHOLD=80
# Horizon waktu prediksi cuaca yang dievaluasi (menit)
EARLY_CLOSE_HORIZON_MINUTES=60
